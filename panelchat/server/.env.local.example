# Local-dev env. Gitignored. Paste real keys here ONLY for local testing;
# rotate any keys that have touched terminal/transcript history.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin console password. Pick a strong one before production.
ADMIN_PASSWORD=devpassword
# 32+ random bytes, base64. `openssl rand -base64 48` is fine.
SESSION_COOKIE_SECRET=local-dev-cookie-secret-change-me-please

PORT=8788
SESSION_ID=panelchat-default
PUBLIC_BASE_URL=http://localhost:8788

# Using real Firestore in the existing CTS project. Admin SDK picks up
# Application Default Credentials from `gcloud auth application-default login`.
GCLOUD_PROJECT=cts-development-485012
GOOGLE_CLOUD_PROJECT=cts-development-485012
