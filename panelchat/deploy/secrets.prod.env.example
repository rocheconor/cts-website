# Production secrets template for panelchat. Copy to deploy/secrets.prod.env
# (gitignored) and fill in real values before running deploy/deploy.sh.
#
# All values are uploaded as discrete GCP Secret Manager secrets prefixed
# with PANELCHAT_*. Rotate any key that has touched terminal/transcript
# history.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 12+ chars. The operator console password.
ADMIN_PASSWORD=

# `openssl rand -base64 48`
SESSION_COOKIE_SECRET=
