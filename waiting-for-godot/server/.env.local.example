# Copy to .env.local and fill in. .env.local is gitignored.

# Provider API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin auth (one shared password for the demo)
ADMIN_PASSWORD=change-me
SESSION_COOKIE_SECRET=use-a-long-random-string-please

# Server
PORT=8787
SESSION_ID=change-makers-2026
PUBLIC_BASE_URL=http://localhost:8787

# Firestore — point to the local emulator by default.
# Comment FIRESTORE_EMULATOR_HOST out and set GOOGLE_APPLICATION_CREDENTIALS
# to use real Firestore.
FIRESTORE_EMULATOR_HOST=localhost:8090
GCLOUD_PROJECT=wfg-local
GOOGLE_CLOUD_PROJECT=wfg-local
