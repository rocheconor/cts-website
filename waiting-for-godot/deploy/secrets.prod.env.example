# PRODUCTION SECRETS — copy to deploy/secrets.prod.env (gitignored) and
# fill in for live deploy. Do not commit. Do not paste contents into chat.

# Provider keys — generate fresh ones in the provider consoles. Any keys
# that have been in terminal history or chat transcripts must be rotated
# (revoke at the provider, create new, paste new values here).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin password — pick something strong (12+ chars, mixed). This is the
# single shared password for the operator console at /wfg/admin/.
ADMIN_PASSWORD=

# Session cookie secret — 32+ bytes of entropy. Generate with one of:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# If this leaks, every admin cookie issued is forgeable.
SESSION_COOKIE_SECRET=
